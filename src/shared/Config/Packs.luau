-- Booster packs, generated by tools/import_cards.py. The last card of every
-- pack is the "hit" slot and uses `hitWeights`; every other slot uses
-- `slotWeights`. `setId = nil` pulls each card from a random set.

local Packs = {}

Packs.List = require(script.Parent:WaitForChild("CardData")).packs

Packs.ById = {}
for _, pack in Packs.List do
	Packs.ById[pack.id] = pack
end

return Packs
